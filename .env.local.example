# ============================================
# DEMOSTRACIÓN EIDA — RED LOCAL SIN INTERNET
# ============================================
# Copiar a .env.local (ignorado por Git); no reemplazar el .env existente.
# Guía: docs/DEMO_LAN_OFFLINE.md
# No hay una IP que cambiar aquí: el navegador utiliza su propio origen.
# Celular: http://IP_LAPTOP:5173 (reemplazar por la IPv4 de ipconfig).
VITE_BACKEND_URL=/backend
VITE_API_URL=/backend/api/v1
VITE_USE_AUTH_MOCK=false
VITE_USE_STUDENTS_MOCK=false
# Alinear con los dominios institucionales del backend.
VITE_EIDA_INSTITUTIONAL_EMAIL_DOMAINS=umss.edu.bo,est.umss.edu

# HTTPS local opcional: configurar AMBAS rutas solo después de crear los
# certificados con mkcert e instalar la CA pública en los dispositivos.
# Estas variables no tienen prefijo VITE_: son para el servidor de desarrollo.
# EIDA_DEV_HTTPS_KEY=.certs/eida-lan-key.pem
# EIDA_DEV_HTTPS_CERT=.certs/eida-lan.pem
# Al cambiar IP_LAPTOP: regenerar el certificado SAN y reiniciar Vite.
